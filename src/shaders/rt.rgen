#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable

// ── Payload ───────────────────────────────────────────────────────────────────
struct HitPayload {
    vec3  hitPos;
    vec3  normal;       // always geometric outward normal from closest-hit
    vec3  albedo;
    float metallic;
    float roughness;
    float transmission;
    bool  missed;
    vec3  missColor;
};

layout(location = 0) rayPayloadEXT HitPayload payload;
layout(location = 1) rayPayloadEXT bool shadowMiss;

// ── Descriptor set 0 ─────────────────────────────────────────────────────────
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba32f) uniform image2D accumImage;
layout(set = 0, binding = 2, rgba32f) uniform image2D outImage;

layout(set = 0, binding = 3) uniform RtUBO {
    mat4  invView;
    mat4  invProj;
    vec4  camPos;
    vec4  lightCounts;       // (numPoint, hasDir, 0, 0)
    vec4  pointLightPos[4];  // (x,y,z, intensity)
    vec4  pointLightColor[4];
    vec4  dirLightDir;       // (x,y,z, intensity)
    vec4  dirLightColor;
    uint  frameIndex;
    uint  maxBounces;
    float _pad0;
    float _pad1;
} ubo;

// ── PCG RNG ───────────────────────────────────────────────────────────────────
uint pcg(inout uint state) {
    uint prev = state * 747796405u + 2891336453u;
    uint word = ((prev >> ((prev >> 28u) + 4u)) ^ prev) * 277803737u;
    state = prev;
    return (word >> 22u) ^ word;
}

float randF(inout uint rng) {
    return float(pcg(rng)) / float(0xFFFFFFFFu);
}

// ── Math helpers ──────────────────────────────────────────────────────────────
const float PI = 3.14159265358979323846;

// Build orthonormal basis around N
mat3 buildBasis(vec3 N) {
    vec3 up = abs(N.y) < 0.999 ? vec3(0,1,0) : vec3(1,0,0);
    vec3 T = normalize(cross(up, N));
    vec3 B = cross(N, T);
    return mat3(T, B, N);
}

// Cosine-weighted hemisphere sample
vec3 cosineSampleHemisphere(inout uint rng) {
    float u1 = randF(rng);
    float u2 = randF(rng);
    float r   = sqrt(u1);
    float phi = 2.0 * PI * u2;
    return vec3(r * cos(phi), r * sin(phi), sqrt(max(0.0, 1.0 - u1)));
}

// GGX importance sampling (half-vector)
vec3 ggxSampleHalfVector(float roughness, inout uint rng) {
    float u1 = randF(rng);
    float u2 = randF(rng);
    float a  = roughness * roughness;
    float cosTheta = sqrt((1.0 - u2) / max(1e-8, 1.0 + (a*a - 1.0) * u2));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    float phi = 2.0 * PI * u1;
    return vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
}

// Fresnel-Schlick
vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(max(0.0, 1.0 - cosTheta), 5.0);
}

float fresnelSchlickScalar(float cosTheta, float F0) {
    return F0 + (1.0 - F0) * pow(max(0.0, 1.0 - cosTheta), 5.0);
}

// GGX NDF
float distributionGGX(float NdotH, float roughness) {
    float a  = roughness * roughness;
    float a2 = a * a;
    float d  = (NdotH * NdotH * (a2 - 1.0) + 1.0);
    return a2 / max(PI * d * d, 1e-8);
}

// Smith geometry term (combined)
float geometrySmith(float NdotV, float NdotL, float roughness) {
    float a = roughness * roughness;
    float k = a * 0.5;
    float gv = NdotV / max(NdotV * (1.0 - k) + k, 1e-8);
    float gl = NdotL / max(NdotL * (1.0 - k) + k, 1e-8);
    return gv * gl;
}

// ── Sky: Rayleigh + Mie approximation with sun disc ──────────────────────────
vec3 skyColor(vec3 dir) {
    vec3  sunDir    = normalize(-ubo.dirLightDir.xyz);
    float cosToSun  = dot(dir, sunDir);
    float elevation = dir.y;

    // Rayleigh gradient: zenith deep blue, horizon pale
    float t = clamp(elevation, 0.0, 1.0);
    vec3  sky = mix(vec3(0.55, 0.72, 1.00), vec3(0.07, 0.18, 0.60), pow(t, 0.45));

    // Mie scattering: warm glow near sun
    sky += vec3(1.1, 0.85, 0.45) * pow(max(cosToSun, 0.0), 6.0) * 0.55;

    // Warm horizon band
    sky = mix(sky, vec3(0.90, 0.58, 0.28), pow(1.0 - t, 6.0) * 0.38);

    // Below horizon: dark earth
    if (elevation < 0.0)
        sky = mix(sky, vec3(0.10, 0.08, 0.06), clamp(-elevation * 3.0, 0.0, 1.0));

    // Sun disc (no trig needed: compare cosine)
    const float SUN_COS = 0.99996;  // cos(0.5 deg)
    if (cosToSun > SUN_COS) {
        float r = (cosToSun - SUN_COS) / (1.0 - SUN_COS);
        sky += vec3(9.0, 7.5, 5.0) * r * (ubo.dirLightDir.w * 0.4 + 0.6);
    }
    // Corona / halo
    sky += vec3(1.8, 1.2, 0.5) * pow(max(cosToSun, 0.0), 64.0) * 0.6;

    return sky;
}

// ── NEE: direct lighting contribution ─────────────────────────────────────────
// Returns the weighted direct radiance contribution (already divided by pdf).
vec3 evalDirectLighting(vec3 pos, vec3 N, vec3 V, vec3 albedo,
                         float metallic, float roughness, inout uint rng)
{
    vec3 F0 = mix(vec3(0.04), albedo, metallic);
    vec3 result = vec3(0.0);
    float alpha = max(roughness * roughness, 1e-4);

    int numPoint = int(ubo.lightCounts.x);
    bool hasDir  = ubo.lightCounts.y > 0.5;

    // Point lights
    for (int i = 0; i < numPoint; i++) {
        vec3  lPos   = ubo.pointLightPos[i].xyz;
        float lIntens = ubo.pointLightPos[i].w;
        vec3  lColor = ubo.pointLightColor[i].xyz;

        vec3  L    = lPos - pos;
        float dist = length(L);
        L /= dist;

        float NdotL = max(dot(N, L), 0.0);
        if (NdotL < 1e-6) continue;

        // Shadow ray (sbtOffset=1 -> shadow hit group with any-hit for glass)
        shadowMiss = false;
        uint shadowFlags = gl_RayFlagsTerminateOnFirstHitEXT |
                           gl_RayFlagsSkipClosestHitShaderEXT;
        traceRayEXT(tlas, shadowFlags, 0xFF, 1, 0, 1,
                    pos + N * 1e-3, 0.0, L, dist - 2e-3, 1);
        if (!shadowMiss) continue;

        vec3 H    = normalize(L + V);
        float NdotH = max(dot(N, H), 0.0);
        float NdotV = max(dot(N, V), 1e-6);
        float HdotL = max(dot(H, L), 0.0);

        // Cook-Torrance specular
        vec3  F  = fresnelSchlick(HdotL, F0);
        float D  = distributionGGX(NdotH, alpha);
        float G  = geometrySmith(NdotV, NdotL, alpha);
        vec3  spec = (D * G * F) / max(4.0 * NdotV * NdotL, 1e-8);

        // Diffuse (Lambertian)
        vec3 kD = (1.0 - F) * (1.0 - metallic);
        vec3 diffuse = kD * albedo / PI;

        float atten = lIntens / (dist * dist);
        result += (diffuse + spec) * NdotL * atten * lColor;
    }

    // Directional light
    if (hasDir) {
        vec3  Ldir   = normalize(-ubo.dirLightDir.xyz);
        float lIntens = ubo.dirLightDir.w;
        vec3  lColor  = ubo.dirLightColor.xyz;

        float NdotL = max(dot(N, Ldir), 0.0);
        if (NdotL > 1e-6) {
            shadowMiss = false;
            uint shadowFlags = gl_RayFlagsTerminateOnFirstHitEXT |
                               gl_RayFlagsSkipClosestHitShaderEXT;
            traceRayEXT(tlas, shadowFlags, 0xFF, 1, 0, 1,
                        pos + N * 1e-3, 0.0, Ldir, 1e4, 1);
            if (shadowMiss) {
                vec3 H    = normalize(Ldir + V);
                float NdotH = max(dot(N, H), 0.0);
                float NdotV = max(dot(N, V), 1e-6);
                float HdotL = max(dot(H, Ldir), 0.0);

                vec3  F  = fresnelSchlick(HdotL, F0);
                float D  = distributionGGX(NdotH, alpha);
                float G  = geometrySmith(NdotV, NdotL, alpha);
                vec3  spec = (D * G * F) / max(4.0 * NdotV * NdotL, 1e-8);

                vec3 kD = (1.0 - F) * (1.0 - metallic);
                vec3 diffuse = kD * albedo / PI;

                result += (diffuse + spec) * NdotL * lIntens * lColor;
            }
        }
    }

    return result;
}

// ── Main ─────────────────────────────────────────────────────────────────────
void main() {
    ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
    ivec2 imgSize    = ivec2(gl_LaunchSizeEXT.xy);

    // Seed: pixel + frame for temporal variety
    uint rng = uint(pixelCoord.x) * 1973u + uint(pixelCoord.y) * 9277u
             + ubo.frameIndex * 26699u;
    rng ^= rng >> 16;
    rng *= 0x45d9f3bu;
    // Warm up
    pcg(rng); pcg(rng);

    // Jittered UV in [-1,1] (Y flipped for Vulkan NDC)
    float jx = randF(rng) - 0.5;
    float jy = randF(rng) - 0.5;
    vec2 uv = (vec2(pixelCoord) + vec2(jx, jy) + vec2(0.5)) / vec2(imgSize);
    vec2 ndc = uv * 2.0 - 1.0;

    // Ray origin + direction from inverse view/proj
    vec4 origin    = ubo.invView * vec4(0, 0, 0, 1);
    vec4 target    = ubo.invProj * vec4(ndc.x, ndc.y, 1, 1);
    vec3 rayDir    = normalize((ubo.invView * vec4(normalize(target.xyz / target.w), 0)).xyz);
    vec3 rayOrigin = origin.xyz;

    // Path tracing state
    vec3 throughput = vec3(1.0);
    vec3 radiance   = vec3(0.0);

    uint maxBounces = ubo.maxBounces;

    for (uint bounce = 0; bounce < maxBounces; bounce++) {
        // Trace primary ray
        payload.missed    = false;
        payload.missColor = vec3(0.0);
        traceRayEXT(tlas,
                    gl_RayFlagsOpaqueEXT,
                    0xFF, 0, 0, 0,
                    rayOrigin, 1e-3, rayDir, 1e4, 0);

        if (payload.missed) {
            radiance += throughput * skyColor(rayDir);
            break;
        }

        vec3  pos         = payload.hitPos;
        vec3  Ngeom       = payload.normal;   // outward geometric normal
        vec3  albedo      = payload.albedo;
        float metallic    = payload.metallic;
        float roughness   = payload.roughness;
        float transmission= payload.transmission;

        // Determine if entering or exiting (for glass refraction)
        bool entering = dot(rayDir, Ngeom) < 0.0;
        vec3 N = entering ? Ngeom : -Ngeom;  // shading normal faces ray
        vec3 V = -rayDir;

        float alpha = max(roughness * roughness, 1e-4);

        // ── Glass path ────────────────────────────────────────────────────
        if (transmission > 0.5) {
            float IOR = 1.5;
            float eta = entering ? (1.0 / IOR) : IOR;

            float cosI = max(dot(N, V), 0.0);
            // Fresnel for glass (scalar, F0 = ((IOR-1)/(IOR+1))^2)
            float F0glass = (IOR - 1.0) / (IOR + 1.0);
            F0glass *= F0glass;
            float F = fresnelSchlickScalar(cosI, F0glass);

            // GGX half-vector for rough glass
            vec3 Hlocal = ggxSampleHalfVector(roughness, rng);
            mat3 basis  = buildBasis(N);
            vec3 H      = normalize(basis * Hlocal);
            if (dot(H, V) < 0.0) H = -H;

            // TIR check
            float sinT2 = eta * eta * (1.0 - dot(V, H) * dot(V, H));
            bool tir    = (sinT2 > 1.0);

            vec3 newDir;
            if (tir || randF(rng) < F) {
                // Reflect
                newDir = reflect(-V, H);
            } else {
                // Refract
                newDir = refract(-V, H, eta);
                if (length(newDir) < 0.5) {
                    // Fallback: just reflect
                    newDir = reflect(-V, H);
                }
            }

            // Tint once when entering the glass medium (not on exit or reflection)
            if (entering && dot(newDir, Ngeom) < 0.0) {
                throughput *= albedo;
            }

            rayOrigin = pos + newDir * 1e-3;
            rayDir    = normalize(newDir);
            continue;
        }

        // ── NEE (direct lighting) — skip for glass ────────────────────────
        radiance += throughput * evalDirectLighting(pos, N, V, albedo, metallic, roughness, rng);

        // ── BSDF importance sampling ──────────────────────────────────────
        vec3 F0 = mix(vec3(0.04), albedo, metallic);

        // Fresnel at view angle (for metal/dielectric split)
        float cosV   = max(dot(N, V), 0.0);
        vec3  Fview  = fresnelSchlick(cosV, F0);
        float specProb = (metallic > 0.9) ? 1.0 : clamp(0.5 + 0.5 * metallic, 0.1, 0.9);

        mat3 basis = buildBasis(N);
        vec3 newDir;

        if (randF(rng) < specProb) {
            // GGX specular / metal reflection
            vec3 Hlocal = ggxSampleHalfVector(alpha, rng);
            vec3 H      = normalize(basis * Hlocal);
            if (dot(H, V) < 0.0) H = -H;
            newDir = reflect(-V, H);

            if (dot(newDir, N) < 0.0) {
                // Bad sample: terminate
                break;
            }

            float NdotL = max(dot(N, newDir), 0.0);
            float NdotV = max(dot(N, V), 1e-6);
            float NdotH = max(dot(N, H), 0.0);
            float VdotH = max(dot(V, H), 0.0);

            float D  = distributionGGX(NdotH, alpha);
            float G  = geometrySmith(NdotV, NdotL, alpha);
            vec3  F  = fresnelSchlick(VdotH, F0);

            // Weight = F * G * VdotH / (NdotH * NdotV)  [GGX importance sample cancellation]
            vec3 weight = (F * G * VdotH) / max(NdotH * NdotV, 1e-8);
            throughput *= weight / specProb;

        } else {
            // Diffuse (cosine hemisphere)
            vec3 Llocal = cosineSampleHemisphere(rng);
            newDir = normalize(basis * Llocal);

            if (dot(newDir, N) < 0.0) break;

            // Diffuse weight: (albedo / PI) * NdotL / pdf, pdf = NdotL/PI => albedo
            vec3 kD = (1.0 - Fview) * (1.0 - metallic);
            throughput *= kD * albedo / (1.0 - specProb);
        }

        rayOrigin = pos + N * 1e-3;
        rayDir    = normalize(newDir);

        // Russian roulette after bounce 3
        if (bounce >= 3) {
            float p = max(throughput.r, max(throughput.g, throughput.b));
            p = clamp(p, 0.05, 0.95);
            if (randF(rng) > p) break;
            throughput /= p;
        }
    }

    // Clamp fireflies
    float lumMax = 20.0;
    float lum = dot(radiance, vec3(0.2126, 0.7152, 0.0722));
    if (lum > lumMax) radiance *= lumMax / lum;

    // Progressive accumulation
    vec4 accum = vec4(0.0);
    if (ubo.frameIndex > 0u) {
        accum = imageLoad(accumImage, pixelCoord);
    }
    accum.rgb += radiance;
    accum.a   += 1.0;
    imageStore(accumImage, pixelCoord, accum);

    // Reinhard tone map + gamma 2.2
    vec3 color = accum.rgb / max(accum.a, 1.0);
    color = color / (color + vec3(1.0));             // Reinhard
    color = pow(clamp(color, 0.0, 1.0), vec3(1.0 / 2.2)); // gamma

    imageStore(outImage, pixelCoord, vec4(color, 1.0));
}
