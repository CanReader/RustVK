#version 460
#extension GL_EXT_ray_tracing : require

layout(location = 1) rayPayloadInEXT bool shadowMiss;

// Vertex: 12 floats (position.xyz, normal.xyz, color.xyz, metallic, roughness, transmission)
layout(set = 0, binding = 4) readonly buffer VertexBuffer { float data[]; } vb;
layout(set = 0, binding = 5) readonly buffer IndexBuffer  { uint  data[]; } ib;

void main() {
    uint i0           = ib.data[gl_PrimitiveID * 3];
    float transmission = vb.data[i0 * 12 + 11];
    if (transmission > 0.5)
        ignoreIntersectionEXT;
    // opaque: accept intersection, shadow ray terminates
}
